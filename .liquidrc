{
  "engine": "11ty",
  "files": {
    "includes": [
      "./docs/src/views/include/*.liquid"
    ],
    "data": [
      "./docs/src/views/data/*.json"
    ]
  },
  "format": {
    "ignore": [
      "./tests/**/*"
    ],
    "wordWrap": 125,
    "indentSize": 2,
    "preserveLine": 1,
    "endNewline": false,
    "preset": "aesthetic",
    "attributeLineBreak": 2
  }
}