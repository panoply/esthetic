{
  "editor.renderWhitespace": "none",
  "json.schemas": [
    {
      "fileMatch": [
        "**/package.json"
      ],
      "url": "./schema.package.json"
    },
    {
      "fileMatch": [
        "Æ",
        "Æ.json",
        ".esthetic",
        ".esthetic.json"
      ],
      "url": "./schema.config.json"
    },
    {
      "url": "https://unpkg.com/tsup/schema.json",
      "fileMatch": [
        "package.json",
        "tsup.config.json"
      ]
    }
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/CVS": true,
    "**/.ruby-lsp": true,
    "**/.vscode": false,
    "**/coverage": true,
    "**/.idea": true,
    "**/.bundle": true,
    "**/LICENSE": true
  },
  "workbench.colorCustomizations": {
    "window.inactiveBorder": "#00aeff",
  },
  "liquid.engine": "11ty",
  "liquid.config.method": "liquidrc",
  "[liquid]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "sissel.shopify-liquid"
  }
}