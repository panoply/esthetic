{
  "name": "esthetic-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Æsthetic Documentation",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "rm -rf public && concurrently \"pnpm run 11ty:watch\" \"pnpm run scss:watch\" \"pnpm tsup:watch\"",
    "stage": "netlify dev -c \"eleventy --watch --serve --watch\" --targetPort 8080",
    "build": "rm -rf public && pnpm run 11ty:build && pnpm run scss:build && pnpm run postcss && pnpm run monaco",
    "postcss": "postcss public/style.css -r --no-map",
    "release": "netlify build && netlify deploy",
    "monaco": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=16384' tsup --minify",
    "11ty:watch": "eleventy --config=.eleventy.cjs --serve --watch",
    "11ty:build": "ENV=prod eleventy --config=.eleventy.cjs",
    "tsup:watch": "tsup --watch",
    "tsup:build": "tsup --minify --env.NODE_ENV production",
    "scss:build": "sass ./src/sass/stylesheet.scss public/style.css --no-source-map",
    "scss:watch": "sass --watch src/sass/stylesheet.scss public/style.css --quiet"
  },
  "eslintConfig": {
    "root": true,
    "ignorePatterns": [
      "index.js",
      "docs/public"
    ],
    "extends": [
      "@liquify/eslint-config"
    ],
    "rules": {
      "no-prototype-builtins": "off",
      "multiline-ternary": "off"
    }
  },
  "prettier": "@liquify/prettier-config",
  "dependencies": {
    "@brixtol/bootstrap": "^1.7.5",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "esthetic": "link:..",
    "json-parse-better-errors": "^1.0.2",
    "lines-and-columns": "^2.0.4",
    "match-sorter": "^8.0.0",
    "mergerino": "^0.4.0",
    "mithril": "^2.2.15",
    "moloko": "workspace:*",
    "papyrus": "workspace:^",
    "qvp": "^0.3.2",
    "relapse": "^0.9.1",
    "spx": "link:../../../../spx",
    "stickybits": "^3.7.11"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@e11ty/eleventy-plugin-search-index": "^0.0.5",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@liquify/eslint-config": "workspace:^",
    "@liquify/prettier-config": "workspace:^",
    "@liquify/stylelint-config": "workspace:^",
    "@netlify/plugin-sitemap": "^0.8.1",
    "@types/browser-sync": "^2.29.0",
    "@types/markdown-it": "^14.1.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cssnano": "^7.0.6",
    "e11ty": "^0.1.4",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "fs-extra": "^11.3.0",
    "gray-matter": "^4.0.3",
    "language-literals": "^0.0.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-for-inline": "^2.0.1",
    "marked": "^15.0.11",
    "monaco-editor": "^0.52.2",
    "netlify-cli": "^20.1.1",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.5.3",
    "sass": "^1.87.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "url-join": "^5.0.0"
  }
}
