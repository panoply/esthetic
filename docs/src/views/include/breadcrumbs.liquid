{% liquid
  assign links = page.url | split: '/'
%}
<div class="row mt-1 gx-2 breadcrumb {% if page.url contains '/rules/' %} mb-5{% endif %}">

  <div class="col-auto">
    {% svg 'home' , 'icon icon-home' %}
  </div>

  <div class="col-auto">
    {% svg 'chevron-right' , 'icon icon-right' %}
  </div>

  <div class="col-auto fc-gray">
    {{ links[1] | replace: '-', ' ' | capitalize }}
  </div>

  {% if links[2] %}
    <div class="col-auto">
      {% svg 'chevron-right' , 'icon icon-right' %}
    </div>
    <div class="col-auto">
      {{ links[2] | replace: '-', ' ' | capitalize }}
    </div>
  {% endif %}

  {% if links[3] %}
    <div class="col-auto">
      {% svg 'chevron-right' , 'icon icon-right' %}
    </div>
    <div class="col-auto fc-gray">
      {% if page.url contains '/rules/' %}
        {{ links[3] | replace: '-', ' ' }}
      {% else %}
        {{ links[3] | replace: '-', ' ' | capitalize }}
      {% endif %}

    </div>
  {% endif %}

</div>