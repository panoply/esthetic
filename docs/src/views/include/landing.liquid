<main
  id="main"
  class="container-fluid">
  <div class="row vh-100 ai-center jc-center px-sm-5">
    <div class="hero d-grid ai-center col-11 col-sm-6 m-auto">
      <div class="hero-github">
        <a
          href="https://github.com/panoply/esthetic"
          target="_blank">
          {% svg 'github-2', 'icon icon-github' %}
        </a>
      </div>

      <div class="d-flex flex-column as-center jc-center logo">
        <a
          href="/introduction/what-is-esthetic/"
          aria-label="Æsthetic Documentation"
          data-tooltip="right"
          spx-target="body">
          {% svg 'æsthetic', 'icon' %}
        </a>
      </div>

      <div class="d-flex flex-column m-auto tc mb-2">
        <h3
          class="d-block caption ff-base light uncase tc px-sm-5"
          style="font-weight: 200;">
          {{ content | remove: '<p>' | remove: '</p>' }}
        </h3>
      </div>

      <div class="row my-3 mx-5 jc-center ai-center pb-5 bb mb-5">
        <a
          href="/introduction/what-is-esthetic/"
          class="col-5 col-md-auto goto-link tc"
          aria-label="Documentation"
          data-tooltip="left"
          spx-target="body">
          Usage
        </a>
        <span class="col-12 col-md-auto fs-sm fc-gray ff-heading tc px-3 my-3 my-sm-0">OR</span>
        <a
          href="/rules/"
          class="col-5 col-md-auto goto-link"
          aria-label="Formatting Rules"
          data-tooltip="right"
          spx-target="body">
          Rules
        </a>
      </div>

      <div class="row ai-center jc-center m-auto tc mb-2">

        <div class="col-12 fs-sm ff-code upper fc-gray">
          {% version %}
        </div>

      </div>

    </div>

    <div class="version fs-xs d-none">
      <a
        href="https://www.npmjs.com/package/esthetic"
        target="_blank">
        {% svg 'npm', 'icon npm-icon' %}
      </a>
    </div>

  </div>
</main>