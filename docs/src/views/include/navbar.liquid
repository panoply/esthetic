<header class="container-fluid navbar pl-0 pb-1 mb-5">
  <div class="row gx-0 jc-between jc-sm-start ai-center bg-white w-100 pl-5">


    <input
      type="button"
      class="d-unset d-sm-none col-auto btn drawer-toggle ml-4"
      spx@click="drawer.toggle">

    {% comment %}
      <div class="d-none d-sm-flex col-auto pr-5">
      <dropdown
      class="dropdown bc-gray rd"
      spx-component="dropdown">
      <button
      type="button"
      class="btn fc-white"
      spx-node="dropdown.button"
      spx@click="dropdown.toggle">{% version %}</button>
      <ul spx-node="dropdown.collapse">
      {% versions %}
      </ul>
      </dropdown>
      </div>
    {% endcomment %}

    <div
      id="navbar"
      class="col-auto">
      {% for link in navigation.navbar %}
        <a
          href="{{ link.url }}"
          title="{{ link.title }}"
          {% if link.title == "Playground" or page.url == "/playground/" %}
            spx-disable
          {% endif %}
          class="d-none d-sm-unset col-auto fw-bolder mr-4 nav-link {{ link.url | active: navigation }}">
          {{ link.title }}
        </a>
      {% endfor %}
    </div>


  </div>
</header>