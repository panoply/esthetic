{%
  liquid

  assign navigate = navigation | navigate
%}

<section class="pt-4">
  {% for item in navigate %}

    {% assign menu_index = forloop.index %}
    {% assign menu_last = forloop.last %}

    {% for link in item.links %}

      {% liquid
        #
        # SKIP LINKS
        #
        unless link.url == page.url
          continue
        endunless
        #
        # PREV AND NEXT LINKS
        #
        if link.url == page.url
          #
          # PREV LINK
          #
          if forloop.first
            assign prev_index = menu_index | minus: 2
            assign prev = navigate[prev_index].links | last
          else
            assign prev_link = forloop.index0 | minus: 1
            assign prev = item.links[prev_link]
          endif
          #
          # NEXT LINK
          #
          if menu_last and forloop.last
            assign next = navigate[0].links | first
          elsif forloop.last
            assign next = navigate[menu_index].links | first
          else
            assign next_index = forloop.index0 | plus: 1
            assign next = item.links[next_index]
          endif
        endif
      %}

      <div class="row jc-between mt-5 mb-3 paginate">

        {% unless menu_index == 1 and forloop.index == 1 %}
          <a
            href="{{ prev.url | url }}"
            class="col-auto prev"
            spx-scroll="0">
            {% svg 'chevron-left', 'icon icon-left mr-2' %}
            {{ prev.title }}
          </a>
        {% endunless %}

        <a
          href="{{ next.url | url }}"
          class="col-auto next ml-auto"
          spx-scroll="0">
          {{ next.title }}
          {% svg 'chevron-right', 'icon icon-right ml-2' %}
        </a>

      </div>

      {% break %}

    {% endfor %}
  {% endfor %}
</section>