<main id="main">
  <div
    class="playground"
    spx-component="playground"
    spx-playground:esthetic="{{'/assets/esthetic.min.js' | url }}"
    spx-playground:loaded="false"
    spx-playground:module="{{'/assets/moloko/moloko.js' | url }}">

    <div
      class="abs-flex ai-center jc-center flex-col d-none"
      spx-node="playground.splash">
      <div class="py-2">
        {% svg 'moloko', 'icon icon-moloko' %}
      </div>
      <div class="mt-5">
        <span class="spinner"></span>
      </div>
    </div>

    <div spx-node="playground.mount"></div>
  </div>
</main>