{% liquid

  if page.url == '/'
    assign url = ''
    assign opened = 'false'
    assign hidden = 'false'
    assign active = ''
  else
    assign opened = 'true'
    assign hidden = 'true'
    assign active = 'drawer-active'
  endif

  assign sidebar = navigation.menu

  if page.url contains '/rules/'
    assign sidebar = navigation.rules
  endif
%}

<aside
  id="sidebar"
  class="drawer-panel drawer-left {{ drawer }} sidebar"
  data-controller="drawer"
  data-drawer-direction-value="left"
  data-drawer-mode-value="push"
  data-drawer-shift-value="#main">

  <div class="container-fluid g-0">

    <form class="p-4 d-none">
      <input
        type="search"
        class="fm-input fm-sm bd bd-1 rd-2"
        placeholder="Search...">
    </form>

    <nav
      id="menu"
      class="sidebar-menu mt-0 mb-2 br-0 bt-0"
      data-relapse="sidebar">

      {% for parent in sidebar %}

        {%
          liquid
          #
          # PARENT NAVIGATION GROUP
          #
          assign mapped_groups = parent.links | map: 'url'
          assign parent_expand = false
          if mapped_groups contains page.url
            assign parent_expand = true
          endif
        %}

        {% if parent.url %}
          <a
            spx-scroll="0"
            href="{{ parent.url | url }}"
            {% if parent_expand %}
              aria-expanded="true"
              class="menu-link active"
            {% else %}
              class="menu-link"
            {% endif %}>
            {{ parent.title }}
          </a>
        {% else %}
          <button
            type="button"
            {% if parent_expand %}
              aria-expanded="true"
              class="menu-link active"
            {% else %}
              class="menu-link"
            {% endif %}>
            {{ parent.title }}
          </button>
        {% endif %}
        <ul
          class="list rel my-0"
          {% unless parent_expand %}
            hidden="true"
          {% endunless %}>
          {% for child in parent.links %}
            {%
              liquid
              #
              # CHILD NAVIGATION GROUP
              #
              assign mapped_child = child.links | map: 'url'
              assign child_expand = false
              if mapped_child contains page.url
                assign child_expand = true
              endif
            %}
            {% if child.links %}
              <li data-relapse>
                <button
                  type="button"
                  {% if page.url == child.url or child_expand %}
                    aria-expanded="true"
                    class="menu-link active"
                  {% else %}
                    class="child-link"
                  {% endif %}>
                  {{ child.title }}
                </button>
                <ul
                  class="child-list rel pl-2"
                  {% unless child_expand %}
                    hidden="true"
                  {% endunless %}>
                  {% for child in child.links %}
                    <li class="pl-1">
                      <a
                        spx-scroll="0"
                        href="{{ child.url | url }}"
                        {% if page.url == child.url %}
                          class="active"
                        {% endif %}>
                        {{ child.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </li>
            {% else %}
              <li>
                <a
                  spx-scroll="0"
                  href="{{ child.url | url }}"
                  aria-disabled="true"
                  {% if page.url == child.url %}
                    class="active"
                  {% endif %}>
                  {{ child.title }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endfor %}
    </nav>
  </div>
</aside>