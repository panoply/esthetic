{% liquid

  assign sample = false

  if page.url == '/'
    assign is_open = 'false'
    assign hidden = 'false'
    assign active = ''
  else
    assign is_open = 'true'
    assign hidden = 'true'
    assign active = 'drawer-active'
  endif

  assign content_group = 'main'
  assign content_class = 'content-docs'

  if page.url contains '/rules'
    unless page.url contains '/usage'
      assign content_group = 'rules'
      assign content_class = 'content-rules'
    endunless
  endif
%}

<!DOCTYPE html>
<html lang="en">
  <head>
    <title>
      Æsthetic | {{ title }}
    </title>
    <meta charset="UTF-8">
    <meta
      content="IE=edge"
      http-equiv="X-UA-Compatible">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0">
    <link
      href="https://fonts.googleapis.com"
      rel="preconnect">
    <link
      href="https://fonts.gstatic.com"
      crossorigin
      rel="preconnect">
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono&display=swap"
      rel="stylesheet"
      spx-eval="false">
    <link
      href="{{'/style.css' | url }}"
      rel="stylesheet"
      spx-eval="false">

    <script
      src="{{'/assets/esthetic.min.js' | url }}"
      spx-eval="false"></script>
    <script
      src="{{'/assets/bundle.min.js' | url }}"
      spx-eval="false"></script>

  </head>
  <body>

    {% if page.url == '/' %}

      {% include 'landing' %}

    {% elsif page.url == '/playground/' %}

      {% include 'navbar' %}
      {% include 'playground' %}

    {% else %}

      {% include 'navbar' %}

      <main
        id="main"
        class="container-fluid {{ content_class }}">

        {% include 'sidebar' %}

        <div class="row">

          <div class="col px-sm-5 content">
            {% include 'breadcrumbs' %}
            {{ content }}
            {% include 'paginate' %}
          </div>

          {% if anchors %}
            <div
              class="col-auto px-4 d-none d-md-unset"
              spx-component="scrollspy">
              {% include 'anchors', anchors: anchors %}
            </div>
          {% endif %}
        </div>
      </main>

    {% endif %}

    {% sprite %}

  </body>
</html>