{
  "exclude": [
    "node_modules/**",
    "public"
  ],
  "include": [
    "src/app/**/*.ts",
    "./.eleventy.d.ts"
  ],
  "compilerOptions": {
    "incremental": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "target": "ES6",
    "lib": [
      "es2020",
      "dom",
      "dom.iterable"
    ],
    "typeRoots": [
      "node_modules/@types",
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "monaco/*": [
        "./src/app/monaco/*"
      ],
    }
  }
}